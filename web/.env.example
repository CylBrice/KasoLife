# KasoLife Web (Next.js) — Variables d'environnement
# Copier en .env.local et renseigner les valeurs réelles (jamais commiter .env.local)

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3000

# URLs
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Firebase (Auth uniquement — Google Sign-In)
# Firebase Console → Paramètres du projet → Mes applications → </> Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# PlanetHoster SMTP relay (utilisé par /api/send-email)
# Doit correspondre à PH_EMAIL_RELAY_SECRET dans le backend .env
PH_EMAIL_RELAY_SECRET=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=noreply@kasolife.com
EMAIL_SMTP_PASS=
