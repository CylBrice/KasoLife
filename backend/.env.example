# ============================================================
# KASOLIFE Backend — Variables d'environnement requises
# Copier en .env et renseigner les valeurs réelles (jamais commiter .env)
# ============================================================

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Sécurité — générer des valeurs aléatoires fortes (openssl rand -hex 32)
JWT_SECRET=
ENCRYPTION_KEY=
# Dédié à la signature HMAC des webhooks — NE PAS réutiliser JWT_SECRET en prod
WEBHOOK_SECRET=
# Secret pour GET /webhook/reconcile (header x-reconcile-secret) — sans lui,
# l'endpoint est inaccessible (fail-closed)
RECONCILE_SECRET=

# CinetPay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_NOTIFY_URL=

# Campay
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_ENV=

# Fapshi
FAPSHI_API_KEY=
FAPSHI_API_USER=
FAPSHI_ENV=

# URLs
BACKEND_URL=
FRONTEND_URL=
ALLOWED_ORIGINS=

# Serveur
PORT=3000
NODE_ENV=development
API_VERSION=

# Monitoring
SENTRY_DSN=

# KYC (Didit)
DIDIT_API_KEY=
DIDIT_CLIENT_ID=
DIDIT_WEBHOOK_SECRET=

# Support
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS
SMS_API_KEY=
SMS_SENDER_ID=
