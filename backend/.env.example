# ============================================================
# KASOLIFE Backend — Variables d'environnement requises
# Copier en .env et renseigner les valeurs réelles (jamais commiter .env)
# ============================================================

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Sécurité — générer des valeurs aléatoires fortes (openssl rand -hex 32)
JWT_SECRET=
ENCRYPTION_KEY=
# Dédié à la signature HMAC des webhooks — NE PAS réutiliser JWT_SECRET en prod
WEBHOOK_SECRET=
# Secret pour GET /webhook/reconcile (header x-reconcile-secret) — sans lui,
# l'endpoint est inaccessible (fail-closed)
RECONCILE_SECRET=

# CinetPay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_NOTIFY_URL=

# Campay
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_ENV=

# Fapshi
FAPSHI_API_KEY=
FAPSHI_API_USER=
FAPSHI_ENV=

# URLs
BACKEND_URL=
FRONTEND_URL=
ALLOWED_ORIGINS=

# Serveur
PORT=3000
NODE_ENV=development
API_VERSION=

# Monitoring
SENTRY_DSN=

# KYC (Didit)
DIDIT_API_KEY=
DIDIT_CLIENT_ID=
DIDIT_WEBHOOK_SECRET=

# Support
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=

# Email — dual provider (même architecture que KasoPlex)
# Provider actif lu depuis platform_config.EMAIL_PROVIDER (RESEND ou PLANETHOSTER)
# Fallback croisé automatique si le provider principal échoue

# Resend (provider 1) : https://resend.com — domaine kasolife.com vérifié requis
RESEND_API_KEY=

# PlanetHoster SMTP relay (provider 2) — Railway bloque le SMTP sortant
# Le backend appelle le frontend Next.js qui relaie via SMTP PlanetHoster
# Configurer dans PlanetHoster cPanel → Email Accounts → noreply@kasolife.com
PH_EMAIL_RELAY_URL=https://kasolife.com
PH_EMAIL_RELAY_SECRET=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=noreply@kasolife.com
EMAIL_SMTP_PASS=

# SMS
SMS_API_KEY=
SMS_SENDER_ID=

# Firebase Admin SDK (Auth uniquement — vérification ID token Google/Apple)
# Firebase Console → Paramètres du projet → Comptes de service → Générer une clé privée
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# PlanetHoster — DNS (pas de code, configuration dans le panel)
# A record  : api.kasolife.com → IP Railway backend
# A record  : kasolife.com + www → IP Vercel frontend
# MX record : kasolife.com → mx.kasolife.com (pour Resend SPF/DKIM/DMARC)
# CNAME     : em.kasolife.com → sendgrid.net (Resend DNS verification)

# ── STORAGE: Cloudflare R2 (avatars) — mêmes clés que KasoPlex ──────────────
# Cloudflare Dashboard → R2 → API Tokens → Create Token
CLOUDFLARE_R2_ENDPOINT=https://095fdd838eca10bfc3ed6efaf34214e9.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=kasolife-storage
# URL publique (activer "Public access" sur le bucket R2 ou domaine custom)
CLOUDFLARE_R2_PUBLIC_URL=
